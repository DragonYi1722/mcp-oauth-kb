# MCP Server
KB_ISSUER=http://localhost:8080/realms/kb
KB_RESOURCE_URL=http://localhost:8000/mcp
KB_JWKS_URI=http://localhost:8080/realms/kb/protocol/openid-connect/certs
KB_DATABASE_URL=postgresql://kb:kb@localhost:5432/kb
# memory: in-process demo data (no Docker); postgres: real database
KB_STORAGE_BACKEND=memory
KB_SEED_DEMO_DATA=true
KB_AUTH_ENABLED=false
KB_LOG_LEVEL=INFO
# true = one JSON object per log line, including request_id
KB_LOG_JSON=false
# Per-subject tool calls per minute; 0 disables the limiter
KB_RATE_LIMIT_PER_MINUTE=60
KB_HOST=0.0.0.0
KB_PORT=8000

# Keycloak bootstrap (development only)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Postgres (development only)
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
